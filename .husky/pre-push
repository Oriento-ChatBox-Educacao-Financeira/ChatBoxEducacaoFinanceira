#!/usr/bin/env sh

# Le o stdin do git e classifica o push.
# Permite push exclusivo de tags ou exclusivo de deletes (limpeza de branch),
# casos em que a validacao de nome de branch nao se aplica.
only_tags=1
all_deletes=1
has_input=0
ZERO_SHA="0000000000000000000000000000000000000000"

while read local_ref local_sha remote_ref remote_sha; do
  has_input=1
  case "$remote_ref" in
    refs/heads/*) only_tags=0 ;;
  esac
  if [ "$local_sha" != "$ZERO_SHA" ]; then
    all_deletes=0
  fi
done

if [ "$has_input" = "1" ] && [ "$only_tags" = "1" ]; then
  exit 0
fi

if [ "$has_input" = "1" ] && [ "$all_deletes" = "1" ]; then
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Bloqueia push direto na main e develop (ruleset do GitHub tambem bloqueia,
# mas o hook economiza o vai-e-volta com o servidor).
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "develop" ]; then
  echo ""
  echo "❌  Push direto em '$BRANCH' nao e permitido."
  echo "    Crie uma branch (ex: feat/minha-feature) e abra um Pull Request."
  echo ""
  exit 1
fi

# Valida padrao de naming git-flow / conventional
PATTERN='^(feat|feature|fix|bugfix|hotfix|refactor|docs|chore|test|style|release)/[a-z0-9._-]+$'

if ! echo "$BRANCH" | grep -Eq "$PATTERN"; then
  echo ""
  echo "❌  Nome da branch '$BRANCH' nao segue o padrao."
  echo ""
  echo "    Use: tipo/descricao-em-kebab-case"
  echo ""
  echo "    Tipos aceitos:"
  echo "      feat | feature      nova feature"
  echo "      fix  | bugfix       correcao de bug"
  echo "      hotfix              fix urgente"
  echo "      refactor            refatoracao"
  echo "      docs                documentacao"
  echo "      chore               manutencao"
  echo "      test                testes"
  echo "      style               ajustes visuais"
  echo "      release             release"
  echo ""
  echo "    Exemplos:  feat/login-google   fix/correcao-rotas   refactor/tela-login"
  echo ""
  echo "    Para renomear:  git branch -m <novo-nome>"
  echo ""
  exit 1
fi

echo "✓ Branch '$BRANCH' OK"
